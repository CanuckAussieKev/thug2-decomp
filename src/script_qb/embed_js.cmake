# NOT ORIGINAL - writes ts_sources.h: each scripting/<name>.js as `inline constexpr unsigned char k_<name>_js[]` (its
# bytes, then a zero) for ts_bridge.cpp. cmake -DOUTPUT=... -DINPUT_DIR=... -DNAMES=a;b -P embed_js.cmake
set(text "// Generated by src/script_qb/embed_js.cmake from scripting/*.js - do not edit.\n#pragma once\n\n")
foreach(name IN LISTS NAMES)
    file(READ "${INPUT_DIR}/${name}.js" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1,\n" hex "${hex}")
    string(APPEND text "inline constexpr unsigned char k_${name}_js[] = {\n${hex}0x00};\n\n")
endforeach()
file(WRITE "${OUTPUT}" "${text}")
