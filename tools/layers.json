{
    "note": "NOT ORIGINAL - the layer map read by tools/layers.ts (docs/architecture.md 'Layers'; the plan for the library split). A library may include itself and the libraries in 'allowed'. 'folders' are prefixes under the repository root; the longest prefix wins. 'strict' libraries have no upward include at all: not even the baseline may list one of theirs. The backends (render_d3d9, audio_dsound, media_bink, input_dinput) are included by app/ only: the editor and the front end reach the graphics backend through the engine's interfaces (render::Device, render::UiBackend), the engine reaches the sound output through audio::Device, the movie codec through media::Movie and DirectInput through its input::Source.",
    "strict": ["base", "platform", "formats", "wire", "engine", "render_d3d9", "audio_dsound", "media_bink", "input_dinput", "game"],
    "libraries": {
        "base": {
            "folders": ["src/base/"],
            "allowed": []
        },
        "platform": { "folders": ["src/platform/"], "allowed": ["base"] },
        "formats": { "folders": ["src/formats/"], "allowed": ["base"] },
        "wire": { "folders": ["src/wire/"], "allowed": ["base", "formats"] },
        "engine": { "folders": ["src/engine/"], "allowed": ["base", "platform", "formats", "wire"] },
        "render_d3d9": { "folders": ["src/render_d3d9/"], "allowed": ["base", "platform", "formats", "wire", "engine"] },
        "audio_dsound": { "folders": ["src/audio_dsound/"], "allowed": ["base", "platform", "formats", "wire", "engine"] },
        "media_bink": { "folders": ["src/media_bink/"], "allowed": ["base", "platform", "formats", "wire", "engine"] },
        "input_dinput": { "folders": ["src/input_dinput/"], "allowed": ["base", "platform", "formats", "wire", "engine"] },
        "game": {
            "folders": ["src/game/"],
            "allowed": ["base", "platform", "formats", "wire", "engine"]
        },
        "frontend": {
            "folders": ["src/frontend/"],
            "allowed": ["base", "platform", "formats", "wire", "engine", "game"]
        },
        "editor": {
            "folders": ["src/editor/"],
            "allowed": ["base", "platform", "formats", "wire", "engine", "game"]
        },
        "devtools": {
            "folders": ["src/devtools/"],
            "allowed": ["base", "platform", "formats", "wire", "engine", "game"]
        },
        "app": {
            "folders": ["src/app/", "src/tests/"],
            "allowed": ["base", "platform", "formats", "wire", "engine", "render_d3d9", "audio_dsound", "media_bink", "input_dinput", "game", "frontend", "editor", "devtools"]
        }
    }
}
