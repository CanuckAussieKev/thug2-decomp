
script anteara_boat {
    Skater:Obj_GetPosition 
    CreateCompositeObject {
        Components=[
            {
                component=model 
                model="Veh\\BA\\Veh_BA_Boat\\Veh_BA_Boat.mdl" 
            } 
            {
                component=skeleton 
                SkeletonName=car 
            } 
            {
                component=Vehicle 
            } 
        ] 
        params={name=boat212 
            pos=(<pos> + (40.0, 20.0, 0.0)) 
            NeverSuspend 
        } 
    } 
} 
