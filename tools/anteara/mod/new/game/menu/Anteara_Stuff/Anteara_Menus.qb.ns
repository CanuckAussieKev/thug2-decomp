
script anteara_cam_test {
    HideSkaterAndMiscSkaterEffects 
    CreateCompositeObject {
        components=
[
            {Component=camera} 
            {Component=input controller=0} 
            {Component=editorcamera max_radius=2000} 
            {Component=GoalEditor} 
        ] 
        params={Name=GoalEditor permanent} 
    } 
    SetActiveCamera Id=GoalEditor 
    <object0_name> = "HUD_Arrow\\HUD_Arrow.mdl" 
    CreateCompositeObject {
        components=
[
            {Component=motion} 
            {Component=Suspend NeverSuspend} 
            {Component=model model=<object0_name>} 
        ] 
        params={Name=GoalEditorCursor} 
    } 
} 
script create_anteara_menu {
    make_new_roundbar_menu {
        title="Anteara Menu" 
        menu_id=pause_menu 
        vmenu_id=pause_vmenu 
        pad_back_script=create_pause_menu 
        Pos=(250.0, 95.0) 
        dims=(250.0, 480.0) 
        internal_text_just=right 
        helper_text=<helper> 
        add_3d_bg1 
    } 
    add_roundbar_menu_item {text="DEBUG MENU" pad_choose_script=create_debug_options_menu scrolling 
    } 
    add_roundbar_menu_item {text="ON/OFF MENU" pad_choose_script=create_onoff_menu scrolling 
    } 
    add_roundbar_menu_item {text="BODY MENU" pad_choose_script=Create_Parts_menu scrolling 
    } 
    if ! GetGlobalFlag flag=ANTEARA_MOD_NOT_ENABLED {
        add_roundbar_menu_item {text="ANIMATION MENU" Id=anteara_anim_button pad_choose_script=anims_menu2_middleman 
        } 
    } else {
        add_roundbar_menu_item {text="ANIMATION MENU" not_focusable=not_focusable Id=anteara_anim_button pad_choose_script=anims_menu2_middleman 
        } 
    } 
    add_roundbar_menu_item {text="VEHICLE MENU" Id=anteara_veh_button pad_choose_script=anteara_vehicle_menu scrolling 
    } 
    add_roundbar_menu_item {text="3D MODEL MENU" pad_choose_script=anteara_model_menu scrolling 
    } 
    add_roundbar_menu_item {text="MISCELLANEOUS MENU" pad_choose_script=create_more_menu scrolling 
    } 
    add_roundbar_menu_item {text="SCREEN MENU" pad_choose_script=create_antearascreen_menu scrolling 
    } 
    add_roundbar_menu_item {text="AMMO, TOD, AND THEMES" pad_choose_script=anteara_theme_menu scrolling 
    } 
    // MERGE: the 2010 version's menu features 2011 doesn't have
    add_roundbar_menu_item {text="2010" pad_choose_script=anteara_2010_menu scrolling 
    } 
    add_roundbar_menu_item {text="test" pad_choose_script=anteara_failsafe scrolling 
    } 
    add_roundbar_menu_item {text="test2" pad_choose_script=RemoveNameFromMessageString scrolling 
    } 
    roundbar_menu_finish 
} 
tempString = "" 
script RemoveNameFromMessageString {
    StringToCharArray string=<string> 
    GetArraySize <char_array> 
    <Index> = 0 
    while {
        if ((<char_array> [<Index>]) = ":") {
            <string_index> = (<Index> + 1) 
            break 
        } 
        <Index> = (<Index> + 1) 
    } <array_size> 
    <new_index> = <string_index> 
    while {
        <char> = ((<char_array> [<new_index>])) 
        FormatText TextName=tempString2 "%a%b" a=(tempString) b=<char> 
        change tempString=<tempString2> 
        <new_index> = (<new_index> + 1) 
    } (<array_size> - <string_index>) 
    return message=<tempString2> 
} 
script anteara_failsafe {
    <AntearaNum> = 0 
    while {
        if SkaterExists Skater=<AntearaNum> {
            if <objId>:ObjectExists Id=<NonLocalPlayerVehicle> {
                SendChatMessage string="set" 
            } else {
                SendChatMessage string="Not Set" 
            } 
        } 
        <AntearaNum> = (<AntearaNum> + 1) 
    } 8 
} 
my_color = [0, 0, 0, 0] 
script troll_hi_xD {
    exit_pause_menu 
    <tmpArray> = my_color 
    SetArrayElement ArrayName=tmpArray Index=0 NewValue=50 
    SetArrayElement ArrayName=tmpArray Index=1 NewValue=80 
    SetArrayElement ArrayName=tmpArray Index=2 NewValue=128 
    SetArrayElement ArrayName=tmpArray Index=3 NewValue=128 
    <my_color> = <tmpArray> 
    create_console_message text="Global My Color" rgba=<my_color> wait_and_die=wait_and_die time=5 
} 
script Anteara_Menu_Lockdown {
    make_new_roundbar_menu {
        title="eh menu" 
        menu_id=pause_menu 
        vmenu_id=pause_vmenu 
        pad_back_script=create_pause_menu 
        Pos=(250.0, 95.0) 
        dims=(250.0, 480.0) 
        internal_text_just=right 
        helper_text=<helper> 
        add_3d_bg1 
    } 
    if ! <objId>:Obj_FlagSet ANTEARA_FAILSAFE_FLAG {
        add_roundbar_menu_item {text="Flag not set" pad_choose_script=anteara_failsafe 
        } 
    } else {
        add_roundbar_menu_item {text="Flag set" pad_choose_script=anteara_failsafe 
        } 
    } 
    roundbar_menu_finish 
} 
