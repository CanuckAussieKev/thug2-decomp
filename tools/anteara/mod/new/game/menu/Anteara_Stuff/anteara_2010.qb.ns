script anteara_nocliponoff {
    make_new_roundbar_menu title="No Clip" pad_back_script=generic_menu_pad_back pad_back_params={callback=anteara_onoff_menu} 
    pause_menu_gradient 
    GoalManager_HideGoalPoints 
    GoalManager_HidePoints 
    unhide_root_window 
    add_roundbar_menu_item {text="On" pad_choose_script=NoClipOn 
    } 
    add_roundbar_menu_item {text="Off" pad_choose_script=anteara_noclipoff 
    } 
    roundbar_menu_finish 
} 
script anteara_lightsonoff {
    make_new_roundbar_menu title="Night Lights" pad_back_script=generic_menu_pad_back pad_back_params={callback=anteara_onoff_menu} 
    add_roundbar_menu_item {text="On" pad_choose_script=anteara_nightON 
    } 
    add_roundbar_menu_item {text="Off" pad_choose_script=anteara_nightOFF 
