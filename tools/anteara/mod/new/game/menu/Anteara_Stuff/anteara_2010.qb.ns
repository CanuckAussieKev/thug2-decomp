script create_ammoyeah_menu {
    make_new_themed_sub_menu title="AMMO MENU" 
    SetScreenElementProps {
        id=sub_menu 
        event_handlers=[{pad_back generic_menu_pad_back params={callback=create_anteara_menu}} 
        ] 
        replace_handlers 
    } 
    skater:GetAmmo 
    theme_menu_add_number_item {
        text="Ammo  --  " 
        id=proj_menu_amount 
        min=0 
        max=10000 
        step=10 
        value=<ammo> 
        pad_choose_script=proj_menu_remove_amount 
        pad_left_script=proj_menu_update_amount 
        pad_right_script=proj_menu_update_amount 
        first_item 
        text_pos=(75.0, -5.0) 
    } 
    theme_menu_add_item text="Choose Item" pad_choose_script=create_ammoitem_menu 
    theme_menu_add_item text="Done" pad_choose_script=create_anteara_menu last_item last_menu_item=1 
    finish_themed_sub_menu 
} 
script create_ammoitem_menu {
    make_new_themed_sub_menu title="ITEM MENU" 
    SetScreenElementProps {
        id=sub_menu 
        event_handlers=[{pad_back generic_menu_pad_back params={callback=create_pause_menu}} 
        ] 
        replace_handlers 
    } 
    theme_menu_add_item text="Apple" pad_choose_script=give_me_ammo pad_choose_params={type=apple} {callback=create_pause_menu} 
    theme_menu_add_item text="Beads" pad_choose_script=give_me_ammo pad_choose_params={type=Beads} 
    theme_menu_add_item text="Shrimp" pad_choose_script=give_me_ammo pad_choose_params={type=shrimp} 
    theme_menu_add_item text="Smokebomb" pad_choose_script=give_me_ammo pad_choose_params={type=smokebomb} 
    theme_menu_add_item text="Skateboard" pad_choose_script=give_me_ammo pad_choose_params={type=skateboard} 
    theme_menu_add_item text="Crystal Ball" pad_choose_script=give_me_ammo pad_choose_params={type=Crystal_Ball} 
    theme_menu_add_item text="Fire" pad_choose_script=give_me_ammo pad_choose_params={type=Anteara_Fire} 
    theme_menu_add_item text="Done" pad_choose_script=create_ammoyeah_menu last_item last_menu_item=1 
    finish_themed_sub_menu 
} 
script give_me_ammo {
    skater:SetAmmoType <type> 
    ammo_type = tomato 
    ammo_type = apple 
    ammo_type = shrimp 
    ammo_type = smokebomb 
    ammo_type = tomato 
    ammo_type = paintcan 
    ammo_type = skateboard 
    ammo_type = Crystal_Ball 
    ammo_type = Anteara_Fire 
    create_ammoyeah_menu 
} 
script anteara_observing_menu {
    make_new_roundbar_menu title="Observe Menu" pad_back_script=generic_menu_pad_back pad_back_params={callback=create_anteara_menu} 
    add_roundbar_menu_item {text="Start Observing" pad_choose_script=anteara_start_observing 
    } 
    add_roundbar_menu_item {text="Stop Observing" pad_choose_script=anteara_stop_observing 
    } 
    roundbar_menu_finish 
} 
script anteara_start_observing {
    skater:remove_skater_from_world 
    EnterSurveyorMode 
    exit_pause_menu 
} 
script anteara_stop_observing {
    skater:add_skater_to_world 
    ExitSurveyorMode 
    exit_pause_menu 
} 
