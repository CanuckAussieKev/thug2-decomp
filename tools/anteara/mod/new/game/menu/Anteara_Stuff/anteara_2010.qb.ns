// MERGE: the 2010 Anteara Mod's menu features that 2011 doesn't have, in one place: Anteara Menu > 2010.
// MERGE: The menus below are 2010's own scripts, unchanged (their Back still goes where it went in 2010, mostly
// MERGE: to the Anteara Menu). Where they call a script 2011 also has (anteara_theme_menu, anteara_timeron,
// MERGE: walljumpon, anteara_noclipoff, flickering_deck...), 2011's version runs.
anteara_2010_keyboard = 0
script anteara_2010_menu {
    make_new_themed_scrolling_menu title="2010 MENU"
    SetScreenElementProps {
        id=sub_menu
        event_handlers=[{pad_back generic_menu_pad_back params={callback=create_anteara_menu}}]
        replace_handlers
    }
    // 2010's Anteara Menu items 2011 removed
    theme_menu_add_item text="ON/OFF MENU" pad_choose_script=anteara_onoff_menu no_bg centered=centered
    theme_menu_add_item text="CUSTOM RESTARTS" pad_choose_script=create_customrestart_menu no_bg centered=centered
    theme_menu_add_item text="AMMO MENU" pad_choose_script=create_ammoyeah_menu no_bg centered=centered
    theme_menu_add_item text="OBSERVE MENU" pad_choose_script=anteara_observing_menu no_bg centered=centered
    theme_menu_add_item text="SPAWN NPCS" pad_choose_script=create_mynpc_menu no_bg centered=centered
    theme_menu_add_item text="NIGHT MENU" pad_choose_script=night_menu no_bg centered=centered
    // 2010's THEME MENU
    theme_menu_add_item text="Balance Meter Colour" pad_choose_script=anteara_bal_menu no_bg centered=centered
    theme_menu_add_item text="Balance Arrow Colour" pad_choose_script=anteara_arrow_menu no_bg centered=centered
    // 2010's VEHICLE MENU and 3D MODEL MENU items
    theme_menu_add_item text="Sit Down Luge" pad_choose_script=anteara_slalom no_bg centered=centered
    theme_menu_add_item text="Halfpipe" pad_choose_script=#fcaa1c10 no_bg centered=centered
    // 2010's MISCELLANEOUS MENU items
    theme_menu_add_item text="FLICKERING SKATER" pad_choose_script=flickering_skater no_bg centered=centered
    theme_menu_add_item text="FLICKERING DECK" pad_choose_script=flickering_deck no_bg centered=centered
    theme_menu_add_item text="CREATE 3D TEXT" pad_choose_script=create_3dtext no_bg centered=centered
    // 2010's SCREEN MODE (its aspect ratio menu)
    theme_menu_add_item text="SCREEN MODE" pad_choose_script=anteara_2010_screen_menu no_bg centered=centered 
    // 2010 scripts no 2010 menu reached (chat commands, or not wired up at all)
    theme_menu_add_item text="GUITAR MENU" pad_choose_script=anteara_guitar_menu no_bg centered=centered
    theme_menu_add_item text="CHAT SPAM (/df)" pad_choose_script=kirillgta_spam no_bg centered=centered
    theme_menu_add_item text="CHAT SPAM: ALX THE BEST (/2010)" pad_choose_script=kirillgta_spam2 no_bg centered=centered
    theme_menu_add_item text="MIDDLEMAN: CLEAN + HELP" pad_choose_script=anteara_middleman no_bg centered=centered
    theme_menu_add_item text="MIDDLEMAN 2: CLEAN + LIGHTS" pad_choose_script=anteara_middleman2 no_bg centered=centered
    theme_menu_add_item text="VEHICLE TEST (TRICYCLE)" pad_choose_script=anteara_vehtest no_bg centered=centered
    theme_menu_add_item text="HIDE BOARD" pad_choose_script=anteara_hide_board no_bg centered=centered
    theme_menu_add_item text="UNHIDE BOARD" pad_choose_script=anteara_unhide_board no_bg centered=centered
    theme_menu_add_item text="MODELS MENU" pad_choose_script=models_menu no_bg centered=centered
    theme_menu_add_item text="Morning RGB2" pad_choose_script=morning_shadows2 no_bg centered=centered
    theme_menu_add_item text="TIME OF DAY TEST MENU" pad_choose_script=test_func3 no_bg centered=centered
    theme_menu_add_item text="TIME OF DAY CYCLE (LOOPS)" pad_choose_script=test_func no_bg centered=centered
    theme_menu_add_item text="CUSTOM POPUP MESSAGE" pad_choose_script=launch_popup_keyboard no_bg centered=centered
    // 2010's keyboard symbols (engine\menu\keyboard.qb) - off: 2011's keyboard
    if (anteara_2010_keyboard = 1) {
        text = "KEYBOARD SYMBOLS (2010): ON"
    } else {
        text = "KEYBOARD SYMBOLS (2010): OFF"
    }
    theme_menu_add_item text=<text> pad_choose_script=toggle_anteara_2010_keyboard no_bg centered=centered
    theme_menu_add_item text="Done" pad_choose_script=create_anteara_menu last_item last_menu_item=1 no_bg centered=centered
    finish_themed_scrolling_menu
}
script toggle_anteara_2010_keyboard {
    if (anteara_2010_keyboard = 1) {
        Change anteara_2010_keyboard=0
    } else {
        Change anteara_2010_keyboard=1
    }
    anteara_2010_menu
}
// MERGE: 2010's own scripts from its gamemenu_pause.qb (2011 dropped them)
script anteara_onoff_menu {
    make_new_roundbar_menu title="On/Off Menu" pad_back_script=generic_menu_pad_back pad_back_params={callback=create_anteara_menu} 
    add_roundbar_menu_item {text="Infinite Combo Run Out Timer" pad_choose_script=anteara_timeronoff 
    } 
    add_roundbar_menu_item {text="Infinite Wall Jumps" pad_choose_script=anteara_walljumponoff 
    } 
    add_roundbar_menu_item {text="Infinite WallShuffles" pad_choose_script=anteara_wallshuffleonoff 
    } 
    add_roundbar_menu_item {text="Skate on Walls" pad_choose_script=anteara_wallskateonoff 
    } 
    add_roundbar_menu_item {text="No Clip" pad_choose_script=anteara_nocliponoff 
    } 
    add_roundbar_menu_item {text="Night Lights" pad_choose_script=anteara_lightsonoff 
    } 
    roundbar_menu_finish 
} 
