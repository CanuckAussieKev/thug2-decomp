script anteara_slalom {
    Vehicle_Start params=slalom_params 
    exit_pause_menu 
} 
// MERGE: 2010's Halfpipe. 2010 compiled its name (anteara_pipe) byte-reversed, as #fcaa1c10, which keeps it apart from
// MERGE: 2011's own anteara_pipe (3D MODEL MENU > Halfpipe) - so it stays #fcaa1c10 here
script #fcaa1c10 {
    skater:Obj_GetPosition 
    CreateCompositeObject {
        Components=[
            {
                component=model 
                model="Veh\\Veh_Half_Pipe\\Veh_Half_Pipe.mdl" 
            } 
            {
                component=rigidbody 
            } 
        ] 
        params={name=pipe212 
            pos=(<pos> + (40.0, 20.0, 0.0)) 
            NeverSuspend 
        } 
    } 
} 
script anteara_vehtest {
    skater:AddGeom name=vehicle model="models\\Veh\\veh_tricycle\\veh_tricycle_skin.skin" 
} 
script anteara_hide_board {
    skater:exit_pause_menu 
    skater:SetBoardMissing 
    skater:SetBoardMissing 
    skater:display 
} 
script anteara_unhide_board {
    skater:exit_pause_menu 
    skater:SetBoardMissing 
    skater:UnsetBoardMissing 
    skater:display 
} 
script create_3dtext {
    if ScreenElementExists id=current_menu_anchor {
        DestroyScreenElement id=current_menu_anchor 
    } 
    create_onscreen_keyboard allow_cancel no_buttons pos=(320.0, 260.0) keyboard_done_script=Create3dText_final keyboard_cancel_script=create_tool_menu display_text="Enter text:" keyboard_title="" min_length=1 max_length=127 display_text_scale=0.5 
} 
script Create3dText_final {
    skater:Obj_GetPosition 
    GetTextElementString id=keyboard_current_string 
    CreateScreenElement {
        id=dynamictext_id 
        type=TextElement 
        parent=root_window 
        font=small 
        text=<string> 
        scale=3.000003 
        pos3D=(<pos> + (0.0, 5.0, 0.0)) 
    } 
    destroy_onscreen_keyboard 
    exit_pause_menu 
} 
script anteara_screen_set_menu {
    if gotparam standard {
        change_screen_mode standard callback=screen_setup_standard set_screen_flags 
    } 
    if gotparam wide {
        change_screen_mode wide callback=screen_setup_widescreen set_screen_flags 
    } 
    if gotparam letter {
        change_screen_mode letter callback=screen_setup_letterbox set_screen_flags 
    } 
    create_anteara_menu 
} 
script kirillgta_spam {
    exit_pause_menu 
    while {
        SendChatMessage string="\\c4FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c1FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c2FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c3FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c4FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c5FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c6FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c7FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\c8FAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\cbFAAAGGOOTTT!" 
        Wait 1 gameframe 
        SendChatMessage string="\\cvFAAAGGOOTTT!" 
        Wait 1 gameframe 
    } 
} 
