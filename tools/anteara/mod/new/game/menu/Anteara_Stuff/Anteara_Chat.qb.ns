case_Auto_Text_Colour = 0 
script entered_chat_message {
    GetTextElementString id=keyboard_current_string 
    if (<string> = "/hi") {
        kirillgta_spam8 
    } 
    if (<string> = "/hai") {
        kirillgta_spam4 
    } 
    if (<string> = "/afk") {
        kirillgta_spam5 
    } 
    if (<string> = "/naw") {
        kirillgta_spam6 
    } 
    if (<string> = "/su") {
        kirillgta_spam7 
    } 
    if (<string> = "//") {
        kirillgta_clean 
    } 
    if (<string> = "/k") {
        kirillgta_dance 
    } 
    if (<string> = "/obs") {
        anteara_observe_obs 
    } 
    if (<string> = "/rotate") {
        Spawn_Try2lol 
    } 
    if (<string> = "/fs") {
        flickering_skater 
    } 
    if (<string> = "/set") {
        set_custom_restart1 
    } 
    if (<string> = "/help") {
        anteara_text_help 
    } 
    if (<string> = "/noclip") {
        MakeSkaterFly 
        Skater:PausePhysics 
    } 
    if (<string> = "/goto") {
        skip_to_custom_restart1 
    } 
    if (<string> = "/lights") {
        anteara_nightON 
    } 
    if (<string> = "/ohai") {
        anteara_spam1 
    } 
    // MERGE: 2010 - the chat commands 2011 dropped (2010's /ohai is 2011's /hai; 2011's /ohai stays)
    if (<string> = "/df") {
        kirillgta_spam 
    } 
    if (<string> = "/2010") {
        kirillgta_spam2 
    } 
    if (<string> = "/type") {
        kirillgta_spam3 
    } 
    if (<string> = "/lolwtf") {
        anteara_spam1 
    } 
    if (<string> = "/norotate") {
        Spawn_Trylol 
    } 
    if (<string> = "/floor") {
        Spawn_floorlol 
    } 
    if (<string> = "/test") {
        Spawn_All_Stuff 
    } 
    if ! ((((((((((((((((((((<string> = "/k") or (<string> = "/floor") or (<string> = "/test") or (<string> = "/floor") or (<string> = "/df") or (<string> = "/obs") or (<string> = "/norotate") or (<string> = "/hi") or (<string> = "/hai") or (<string> = "/afk") or (<string> = "/naw") or (<string> = "/su") or (<string> = "//") or (<string> = "/fs") or (<string> = "/set") or (<string> = "/goto") or (<string> = "/lights") or (<string> = "/ohai") or (<string> = "/help") or (<string> = "/noclip") or (<string> = "/rotate") or (<string> = "/2010") or (<string> = "/type") or (<string> = "/lolwtf")))))))))))))))))))) {
        GetPreferenceChecksum pref_type=network TextColor 
        switch <checksum>
            case color_ca {
                color = "\\ca" 
            }
            case color_cL {
                color = "\\cL" 
            }
            case color_c4 {
                color = "\\c4" 
            }
            case color_c0 {
                color = "\\c0" 
            }
            case color_cb {
                color = "\\cb" 
            }
        endswitch        
        GetTextElementString id=keyboard_current_string 
        if (<string> = "/colora") {
            SetPreferencesFromUI prefs=network field="TextColor" checksum=color_ca 
        } 
        if (<string> = "/colorb") {
            SetPreferencesFromUI prefs=network field="TextColor" checksum=color_cb 
        } 
        FormatText TextName=colour_text "%c%s" c=<color> s=<string> 
        if ! ((<string> = "/colora") or (<string> = "/colorb")) {
            SendChatMessage string=<colour_text> 
        } else {
            GetPreferenceChecksum pref_type=network TextColor 
            switch <checksum>
                case color_ca {
                    color = "\\\\ca" 
                }
                case color_cb {
                    color = "\\\\cb" 
                }
            endswitch            
            FormatText TextName=msg "Text color changed to %c" c=<color> 
            SendChatMessage string=<msg> 
        } 
    } 
    destroy_onscreen_keyboard 
} 
script anteara_3d_text {
    if ScreenElementExists id=current_menu_anchor {
        DestroyScreenElement id=current_menu_anchor 
    } 
    create_onscreen_keyboard {
        allow_cancel 
        no_buttons 
        pos=(320.0, 260.0) 
        keyboard_done_script=Add_text_to_world 
        keyboard_cancel_script=create_more_menu 
        display_text="Create 3D Text: " 
        keyboard_title="Lolol." 
        min_length=1 
        max_length=127 
        display_text_scale=0.5 
    } 
} 
script Add_text_to_world {
    Skater:Obj_GetPosition 
    GetTextElementString id=keyboard_current_string 
    CreateScreenElement {
        id=anteara_3d_text 
        type=TextElement 
        parent=root_window 
        font=dialog 
        text=<string> 
        scale=3.000003 
        pos3D=(<pos> + (0.0, 5.0, 0.0)) 
    } 
    destroy_onscreen_keyboard 
    exit_pause_menu 
} 
script Spawn_Trylol {
    Create Name=BO_BarrierQP01 
    GoalEditorCursor:Obj_GetPosition 
    GoalEditorCursor:Obj_GetOrientation 
    BO_BarrierQP01:Obj_SetPosition Position=(<pos> + (0.0, 35.75, 0.0)) 
    BO_BarrierQP01:Obj_Rotate y=<angle> 
} 
script Spawn_Try2lol {
    Create Name=BO_BarrierQP01 
    Skater:Obj_GetPosition 
    BO_BarrierQP01:Obj_SetPosition Position=(<pos> + (0.0, 35.75, 0.0)) 
    BO_BarrierQP01:Obj_Rotate absolute=(0.0, 180.0, 0.0) 
    FormatText TextName=c_popup "Rotated Pos:\\cB %p" p=<pos> 
    SendChatMessage string=<c_popup> 
} 
script Spawn_floorlol {
    Create Name=BO_Scaffolding02 
    Skater:Obj_GetPosition 
    BO_Scaffolding02:Obj_SetPosition Position=(<pos> + (0.0, 35.75, 0.0)) 
    FormatText TextName=c_popup "Floor Pos:\\cB %p" p=<pos> 
    SendChatMessage string=<c_popup> 
} 
script Spawn_All_Stuff {
    MakeSkaterGoto Switch_OnGroundAi params={NewScript=Walking_OnGroundAi Restart} 
    OneTest 
    TwoTest 
    ThreeTest 
    FourTest 
    FiveTest 
    SixTest 
    Skater:Obj_SetPosition Position=(3997.803, 1143.375, -402.154) 
    Skater:Obj_Rotate absolute=(0.0, 270.0, 0.0) 
} 
