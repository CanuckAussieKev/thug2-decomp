// MERGE: 2010 - the luge and slalom animations (Sit Down Luge in the 2010 menu)
script animload_THPS6_LugeandSlalom {LoadFunction = LoadAnim 
    SetReferenceChecksum THPS6_human 
    if <LoadFunction> <...> name="anims\\skater_luge\\Luge_AirIdle.ska" descChecksum=Luge_AirIdle {
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Brake.ska" descChecksum=Luge_Brake 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Fullstop.ska" descChecksum=Luge_Fullstop 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Idle.ska" descChecksum=Luge_Idle 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_IdleToLeanLeft.ska" descChecksum=Luge_IdleToLeanLeft 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_IdleToLeanRight.ska" descChecksum=Luge_IdleToLeanRight 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Land.ska" descChecksum=Luge_Land 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_LookLeft.ska" descChecksum=Luge_LookLeft 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_LookRight.ska" descChecksum=Luge_LookRight 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Ollie.ska" descChecksum=Luge_Ollie 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Push.ska" descChecksum=Luge_Push 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Sit.ska" descChecksum=Luge_Sit 
        <LoadFunction> <...> name="anims\\skater_luge\\Luge_Flail.ska" descChecksum=Luge_Flail 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_AirIdle.ska" descChecksum=slalom_AirIdle 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_Idle.ska" descChecksum=slalom_Idle 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_IdleToLeanLeft.ska" descChecksum=slalom_IdleToLeanLeft 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_IdleToLeanRight.ska" descChecksum=slalom_IdleToLeanRight 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_Land.ska" descChecksum=slalom_Land 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_Ollie.ska" descChecksum=slalom_Ollie 
        <LoadFunction> <...> name="anims\\skater_slalom\\slalom_Flail.ska" descChecksum=slalom_Flail 
    } 
    SetReferenceChecksum 0 
} 
