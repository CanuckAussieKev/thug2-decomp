script rotate_pause_deck3 {
    if ! ObjectExists id=menu3d_sign3 {
        return 
    } 
    rot_angle = 0 
    DoScreenElementMorph time=0.25 id=menu3d_sign3 pos=(150.0, 280.0) 
    while {
        if ! ObjectExists id=menu3d_sign3 {
            return 
        } 
        SetScreenElementProps id=menu3d_sign3 angley=<rot_angle> 
        rot_angle = (<rot_angle> + 0.0625) 
        wait 1 gameframes 
    } 
} 
