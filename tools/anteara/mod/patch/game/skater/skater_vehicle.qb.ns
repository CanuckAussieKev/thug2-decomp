Anteara_Is_In_Story_Vehicle = 0 
script Vehicle_Start {
    change Anteara_Is_In_Story_Vehicle=1 
    // MERGE: slalom_params added back to the list (as in retail) for the 2010 slalom
    skater:RemoveTags tags=[gurney_params segway_params tricycle_params wheelchair_params minikart_params mechbull_params luge_params riskblade_params wings_params slalom_params] 
    skater:SetTags {<params> InAirTrick=0} 
    MakeSkaterGoto Vehicle_Start2 
} 
script vehicle_land2 {RevertTime = 5 
    if LandedFromVert {
        if (<allow_vert> = 0) {
            Goto Vehicle_Bail 
        } 
        OverrideCancelGround 
        Obj_ClearFlag FLAG_SKATER_MANUALCHEESE 
        if gotparam revert_trick {
            GetSpeed 
            if (<speed> > 250) {
                SetExtraTricks_Reverts Duration=<RevertTime> 
            } 
        } 
    } else {
        if gotparam canmanual {
            DoNextManualTrick 
        } 
    } 
    OnExceptionRun LandSkaterTricks 
    SetException Ex=Ollied Scr=Vehicle_Ollie 
    SetException Ex=RunHasEnded Scr=EndOfRun 
    SetException Ex=GoalHasEnded Scr=Goal_EndOfRun 
    GetTags 
    if gotparam land_sound {
        PlaySound <land_sound> vol=150 pitch=random { 1 { 95 } 1 { 98 } 1 { 100 } 1 { 103 } 1 { 105 } } 
    } 
    if gotparam soft_land_anim {
        if AirTimeGreaterThan 1 seconds {
            PlayAnim Anim=<land_anim> Blendperiod=0.1 
        } else {
            if AirTimeGreaterThan 0.1 seconds {
                PlayAnim Anim=<soft_land_anim> Blendperiod=0.1 
            } 
        } 
    } else {
        PlayAnim Anim=<land_anim> Blendperiod=0.1 
    } 
    GetTags 
    if (<racemode> = gurney) {
        if SkaterSpeedGreaterThan 0 {
            if ! IsSoundPlaying ShoppingCartLoop {
                if (LevelIs load_bo) {
                    printf "vehicle_land2 - Quickly Stopping then starting shoppingcartloop sound" 
                    skater:Obj_StopSound ShoppingCartLoop 
                    skater:Obj_PlaySound ShoppingCartLoop 
                    SetSoundParams ShoppingCartLoop vol=0 pitch=0 
                } 
            } 
        } 
    } 
    if gotparam spin_time {
        wait <spin_time> seconds 
        CancelRotateDisplay 
    } 
    if gotparam revert_trick {
        if LandedFromVert {
            ResetLandedFromVert 
            while {
                wait 1 gameframe 
            } <RevertTime> 
        } else {
            while {
                DoNextManualTrick FromAir 
                wait 1 gameframe 
            } 10 
        } 
    } 
    LandSkaterTricks 
    if GameModeEquals is_career {
        if (<racemode> = Wheelchair) {
            Paulie_TalkShit 
        } 
    } 
    Obj_WaitAnimFinished 
    Goto Vehicle_OnGround 
} 
