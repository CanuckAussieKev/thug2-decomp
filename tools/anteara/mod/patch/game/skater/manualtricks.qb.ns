script OneButtonTest {
    ClearTrickQueue 
    ClearEventBuffer Buttons=Dpad OlderThan=TRICK_PRELOAD_TIME 
    SetTrickName <Name> 
    SetTrickScore <Score> 
    display 
    SetException Ex=Landed Scr=TrickLand Params={<...>} 
    BlendPeriodOut 0 
    Obj_WaitAnimFinished 
    SetException Ex=GroundGone Scr=GroundGone 
    LandSkaterTricks 
    DoNextManualTrick 
} 
