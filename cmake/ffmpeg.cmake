# --- FFmpeg 7.1.5 (LGPL 2.1 or later) for the FFmpeg movie codec (src/media_ffmpeg) ---------------------------------
# The codec loads FFmpeg's DLLs by name at run time (src/media_ffmpeg/ffmpeg_api.h): nothing is linked, so the build
# needs only FFmpeg's headers - the source of the release tag n7.1.5, pinned like the other fetched code (the same files
# as FFmpeg's signed release tarball, which the DLLs are built from: tools/ffmpeg/build_ffmpeg.ts). The one header
# configure would generate, libavutil/avconfig.h, is written here (the byte order and unaligned access of x86 / x64).
FetchContent_Declare(ffmpeg_headers
    URL https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n7.1.5.tar.gz
    URL_HASH SHA256=e3963a50831c985933e1a625ed566ec4c7adb5c012c34fa9f84438e1d61bdacc
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR no-cmake) # headers only
FetchContent_MakeAvailable(ffmpeg_headers)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/ffmpeg/libavutil/avconfig.h"
    CONTENT "/* Generated by cmake/ffmpeg.cmake (what FFmpeg's configure writes for x86 and x64) */\n#ifndef AVUTIL_AVCONFIG_H\n#define AVUTIL_AVCONFIG_H\n#define AV_HAVE_BIGENDIAN 0\n#define AV_HAVE_FAST_UNALIGNED 1\n#endif /* AVUTIL_AVCONFIG_H */\n")
add_library(ffmpeg_headers INTERFACE)
target_include_directories(ffmpeg_headers SYSTEM INTERFACE "${CMAKE_BINARY_DIR}/generated/ffmpeg" "${ffmpeg_headers_SOURCE_DIR}")
target_compile_definitions(ffmpeg_headers INTERFACE __STDC_CONSTANT_MACROS)

# The DLLs, built by `node tools/ffmpeg/build_ffmpeg.ts --arch x86` (x64 for a 64-bit build) into out/ffmpeg/<arch>.
# When they are there, every build copies them next to the exe (and into the game folder with it); without them the
# exe still builds and runs - movie_codec=ffmpeg then logs that they are missing and plays the movies with Bink.
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(THUG2_FFMPEG_ARCH x64)
else()
    set(THUG2_FFMPEG_ARCH x86)
endif()
set(THUG2_FFMPEG_DIR "${CMAKE_SOURCE_DIR}/out/ffmpeg/${THUG2_FFMPEG_ARCH}" CACHE PATH
    "The folder tools/ffmpeg/build_ffmpeg.ts built FFmpeg into (its bin/ holds the DLLs)")
set(THUG2_FFMPEG_DLLS "")
foreach(dll avutil-59.dll avcodec-61.dll avformat-61.dll swscale-8.dll)
    if(EXISTS "${THUG2_FFMPEG_DIR}/bin/${dll}")
        list(APPEND THUG2_FFMPEG_DLLS "${THUG2_FFMPEG_DIR}/bin/${dll}")
    endif()
endforeach()
list(LENGTH THUG2_FFMPEG_DLLS THUG2_FFMPEG_DLL_COUNT)
if(NOT THUG2_FFMPEG_DLL_COUNT EQUAL 4)
    set(THUG2_FFMPEG_DLLS "")
    message(STATUS "FFmpeg's DLLs aren't in ${THUG2_FFMPEG_DIR}/bin (node tools/ffmpeg/build_ffmpeg.ts builds them): "
                   "movie_codec=ffmpeg will fall back to Bink")
endif()
