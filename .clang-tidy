# The project's checks (docs/style-guide.md): the C++ Core Guidelines' checks and the bug-finding, modernising and
# performance groups, with the house naming rules. Zero warnings is the rule; a place that can't keep a check says so
# with `// NOLINT(<check>): <reason>` (or NOLINTBEGIN / NOLINTEND around a listed record) - docs/style-guide.md
# "Exceptions". Every check switched off is listed below with its reason.
# Run: clang-tidy -p out/build/<preset> --extra-arg=--target=i686-pc-windows-msvc <file>
Checks:
  - '-*'
  - 'bugprone-*'
  - 'cppcoreguidelines-*'
  - 'misc-*'
  - 'modernize-*'
  - 'performance-*'
  - 'readability-identifier-naming'

  # --- off: they conflict with the project's decisions ---
  # The project writes `int f()`; trailing return types are a style, not a Guideline.
  - '-modernize-use-trailing-return-type'
  # The decompiled constants (tuning values, checksums, flags, layout offsets) are the original's: naming each would
  # invent names the binary doesn't give. Constants get names where their meaning is known.
  - '-cppcoreguidelines-avoid-magic-numbers'
  # The engine still walks its vertex streams, texel rows, text buffers and packed records by pointer: 992 places
  # over src/ (round 3n of stage 9, down from 1,501, 1,938, 2,276, 2,599, 3,658 and 5,043 before; the check alone; the
  # boundary layer and the script token streams at 0). They go to std::span,
  # core::Cursor (a span and a position, checked) and indices subsystem by subsystem; the check is switched on at 0.
  - '-cppcoreguidelines-pro-bounds-pointer-arithmetic'
  # The tables mirror the original's data positionally (script commands, member tables, key maps).
  - '-modernize-use-designated-initializers'
  # The engine's classes are data layouts shared between subsystems, as the original's were.
  - '-misc-non-private-member-variables-in-classes'
  # No include-what-you-use mapping for the Windows / DirectX / SDL headers: its advice there is wrong.
  - '-misc-include-cleaner'
  # The game's globals are the original's state (g_ names).
  - '-cppcoreguidelines-avoid-non-const-global-variables'
  # The game's printf-style formatting is kept for its exact output (std::format would change it).
  - '-cppcoreguidelines-pro-type-vararg'
  # The original's signatures (x, y, z / width, height): to come on with strong types (Vec2 / Vec3, Rect, checksum and
  # id types) and parameter structs once the boundary layer keeps the layouts apart.
  - '-bugprone-easily-swappable-parameters'
  # The script interpreter, the screen element tree and the scene walks recurse by design.
  - '-misc-no-recursion'
  # The original's loop shapes, kept for comparison with the disassembly.
  - '-cppcoreguidelines-avoid-do-while'

# SDL_endian.h defines _m_prefetch, which clang's own intrinsics header declares too: keep clang's out
ExtraArgs: ['-D__PRFCHWINTRIN_H']
WarningsAsErrors: ''
HeaderFilterRegex: '.*[/\\]src[/\\](platform|formats|wire|gpu|engine|game|frontend|editor)[/\\].*'
CheckOptions:
  # An allocation failure ends the game whether or not it leaves a noexcept function (no handler anywhere: the
  # game has no exception handling); the debug runtime's container moves allocate, so every move of a container
  # would otherwise be "may throw". Every other exception still counts.
  bugprone-exception-escape.IgnoredExceptions: 'bad_alloc,bad_array_new_length'
  # Only a literal that is exactly the constant's value (the original's own digits otherwise stay).
  modernize-use-std-numbers.DiffThreshold: '0'
  # The maths types check their own index (Vec4's component, Mat4's row: an index outside them ends the game with a
  # report), as core::at does for the containers; so does core::Cursor (a position in a run of elements: the element read
  # or written is checked against the run).
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::maths::Vec4;::maths::Mat4;::core::Cursor;::core::CStringCursor'
  # The rule of five, as the Guidelines' C.21 allows it: a defaulted destructor alone, and classes that only copy
  # (their copies stand in for moves).
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case
  readability-identifier-naming.GlobalVariableCase: lower_case
  readability-identifier-naming.GlobalVariablePrefix: 'g_'
  # file statics that alias a global keep s_
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^s_[a-z0-9_]+$'
  readability-identifier-naming.GlobalPointerCase: lower_case
  readability-identifier-naming.GlobalPointerPrefix: 'g_'
  readability-identifier-naming.GlobalPointerIgnoredRegexp: '^s_[a-z0-9_]+$'
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.MemberSuffix: '_'
  # plain one-word members of small data structs (x, y, length) keep no suffix
  readability-identifier-naming.MemberIgnoredRegexp: '^[a-z][a-z0-9]*$'
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: '_'
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: 'k'
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: 'k'
  readability-identifier-naming.GlobalConstantPointerCase: CamelCase
  readability-identifier-naming.GlobalConstantPointerPrefix: 'k'
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: 'k'
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: 'k'
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: 'k'
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
