{
  "name": "thug2-decomp-tools",
  "private": true,
  "type": "module",
  "description": "The THUG2 decompilation's tools (tools/), TypeScript run directly by Node (docs/typescript.md).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "tools/pipeline"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check tools",
    "format": "biome check --write tools",
    "test": "node --test \"tools/**/*.test.ts\" && node tools/dependency_tests.ts",
    "zfight-raster": "node tools/pipeline/run.ts level_port/zfight_raster.ts"
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#c10980836184700eed8acb551ddaebf854bd67d8",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#83d4eefa45c98e49c68cb6e995db7ab2b0250a49"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
