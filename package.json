{
  "name": "thug2-decomp-tools",
  "private": true,
  "type": "module",
  "description": "The THUG2 decompilation's tools (tools/), TypeScript run directly by Node (docs/typescript.md).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "tools/pipeline"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check tools",
    "format": "biome check --write tools",
    "test": "node --test \"tools/**/*.test.ts\" && node tools/dependency_tests.ts",
    "zfight-raster": "node tools/pipeline/run.ts level_port/zfight_raster.ts"
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#f394e983eb339d3c782c7ced7b1bb8b3bbe43ef9",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#c31c9e69a56c1d4073bb2bad7d0f2844d59484bb"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
